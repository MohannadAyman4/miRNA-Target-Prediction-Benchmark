============================================================
6) TARGETNET - METRICS (0.5 AND 0.7)
============================================================

cd ~/miRBench

python - <<'PY'
import pandas as pd
from sklearn.metrics import (
    average_precision_score,
    roc_auc_score,
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix
)

df = pd.read_csv("TargetNet_1018_prediction_file.csv")

y_true = df["label"].astype(int)

print("============================================")
print("TARGETNET - AGO2_CLASH_Hejret2023 (test)")
print("============================================")

for threshold in [0.5, 0.7]:

    y_score = df["prediction_score"]
    y_pred = (y_score >= threshold).astype(int)

    ap = average_precision_score(y_true, y_score)
    roc_auc = roc_auc_score(y_true, y_score)

    accuracy = accuracy_score(y_true, y_pred)
    precision = precision_score(y_true, y_pred, zero_division=0)
    recall = recall_score(y_true, y_pred, zero_division=0)
    f1 = f1_score(y_true, y_pred, zero_division=0)

    tn, fp, fn, tp = confusion_matrix(
        y_true,
        y_pred,
        labels=[0, 1]
    ).ravel()

    specificity = tn / (tn + fp) if (tn + fp) else 0.0

    print("\n--------------------------------------------")
    print(f"Threshold = {threshold}")
    print("--------------------------------------------")
    print(f"Samples      : {len(df)}")
    print(f"AP           : {ap:.4f}")
    print(f"ROC-AUC      : {roc_auc:.4f}")
    print(f"Accuracy     : {accuracy:.4f}")
    print(f"Precision    : {precision:.4f}")
    print(f"Recall       : {recall:.4f}")
    print(f"Specificity  : {specificity:.4f}")
    print(f"F1-Score     : {f1:.4f}")
    print(f"TN           : {tn}")
    print(f"FP           : {fp}")
    print(f"FN           : {fn}")
    print(f"TP           : {tp}")
    print(f"Predicted +  : {y_pred.sum()}")
PY

# Notes:
# AP and ROC-AUC use continuous prediction_score and do not change
# when threshold changes.
# Accuracy/Precision/Recall/Specificity/F1/TN/FP/FN/TP depend on threshold.


